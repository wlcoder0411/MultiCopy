<Window x:Class="MultiCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MultiCopy.Models"
        xmlns:vm="clr-namespace:MultiCopy.ViewModels"
        xmlns:infra="clr-namespace:MultiCopy.Infrastructure"
        Title="MultiCopy"
        Width="384" Height="560"
        MinWidth="320" MinHeight="360"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />

        <!-- 分组标签右键菜单：PlacementTarget = 标签 Button（Tag = 窗口 DataContext，DataContext = ClipboardTab）。
             仅分组标签通过 DataTemplate.Triggers 挂载本菜单 -->
        <ContextMenu x:Key="TabGroupMenu">
            <MenuItem Header="置顶"
                      Command="{Binding PlacementTarget.Tag.PinGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Group, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Visibility>
                    <Binding Path="PlacementTarget.DataContext.Group.IsPinned"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}"
                             Converter="{x:Static infra:InverseBoolToVisibilityConverter.Instance}" />
                </MenuItem.Visibility>
            </MenuItem>
            <MenuItem Header="取消置顶"
                      Command="{Binding PlacementTarget.Tag.UnpinGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Group, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Visibility>
                    <Binding Path="PlacementTarget.DataContext.Group.IsPinned"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}"
                             Converter="{StaticResource Bool2Vis}" />
                </MenuItem.Visibility>
            </MenuItem>
            <MenuItem Header="重命名"
                      Command="{Binding PlacementTarget.Tag.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Group, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="清空组内项"
                      Command="{Binding PlacementTarget.Tag.ClearGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Group, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="删除分组"
                      Command="{Binding PlacementTarget.Tag.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Group, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- ============ 顶部标签：药丸按钮 + 📌 标记 + 活动分组圆点 ============
             点击经 Tab_Click 处理（拖拽后需抑制误触，见 TabDragMove）；
             仅普通分组标签可拖拽重排（约束判断在 TabDragStart / Tab_DragOver） -->
        <DataTemplate x:Key="TabItemTemplate" DataType="{x:Type vm:ClipboardTab}">
            <Button x:Name="TabPill" Style="{StaticResource TabPill}"
                    Click="Tab_Click"
                    PreviewMouseLeftButtonDown="TabDragStart"
                    PreviewMouseMove="TabDragMove"
                    AllowDrop="True"
                    DragOver="Tab_DragOver"
                    Drop="Tab_Drop"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPin}"
                          Width="11" Height="11" Margin="0,0,4,0"
                          Stroke="{DynamicResource PinBrush}" Fill="{DynamicResource PinBrush}"
                          Visibility="{Binding ShowPin, Converter={StaticResource Bool2Vis}}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Title}"
                               Visibility="{Binding IsGroupTab, Converter={x:Static infra:InverseBoolToVisibilityConverter.Instance}}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Group.Name}"
                               Visibility="{Binding IsGroupTab, Converter={StaticResource Bool2Vis}}" />
                    <Ellipse Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}"
                             Visibility="{Binding Group.IsActiveGroup, Converter={StaticResource Bool2Vis}, FallbackValue=Collapsed}" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Group">
                    <Setter TargetName="TabPill" Property="ContextMenu" Value="{StaticResource TabGroupMenu}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinnedGroup}" Value="True">
                    <Setter TargetName="TabPill" Property="ToolTip"
                            Value="置顶分组：内容跨会话保留、不参与自动出队；不接收新复制内容" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 列表项容器：去掉默认选中高亮，由条目模板的选中环负责 -->
        <Style x:Key="ClipboardListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 内容行：文本 ============ -->
        <DataTemplate x:Key="TextItemTemplate" DataType="{x:Type vm:ClipboardItemRow}">
            <Border x:Name="selectionRing" Margin="6,1" BorderThickness="2" CornerRadius="8"
                    BorderBrush="Transparent" Background="Transparent"
                    PreviewMouseLeftButtonDown="ItemDragStart"
                    PreviewMouseMove="ItemDragMove"
                    MouseLeftButtonUp="Item_Click"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border.ContextMenu>
                    <ContextMenu Opened="ItemContextMenu_Opened">
                        <MenuItem x:Name="MoveMenu" Header="移动到分组…"
                                  ToolTip="将此项移到其他分组"
                                  Visibility="{Binding PlacementTarget.DataContext.CanManage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Bool2Vis}}" />
                        <MenuItem Header="按行拆分为多条"
                                  ToolTip="把多行文本拆成多条，按原位置插入"
                                  Command="{Binding PlacementTarget.Tag.SplitLinesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.CanSplit, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Bool2Vis}}" />
                        <Separator />
                        <MenuItem Header="置顶"
                                  Command="{Binding PlacementTarget.Tag.PinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.CanPin, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Bool2Vis}}" />
                        <MenuItem Header="取消置顶"
                                  Command="{Binding PlacementTarget.Tag.UnpinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.CanUnpin, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Bool2Vis}}" />
                        <MenuItem Header="删除"
                                  Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border x:Name="card" Padding="8,6" CornerRadius="6" Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinnedContext}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PinBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PinBrush}" />
                                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding IsPinnedContext}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding IsPinnedContext}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource PinBackgroundHoverBrush}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Text="{Binding Item.DisplayIndex}" />

                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0"
                                   Text="{Binding Item.Preview}" ToolTip="{Binding Item.Text}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Item.RelativeTime}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" ToolTip="置顶"
                                    Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Item}"
                                    Visibility="{Binding CanPin, Converter={StaticResource Bool2Vis}}">
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPin}" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" ToolTip="取消置顶"
                                    Command="{Binding DataContext.UnpinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Item}"
                                    Visibility="{Binding CanUnpin, Converter={StaticResource Bool2Vis}}">
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPin}"
                                      Stroke="{DynamicResource PinBrush}" Fill="{DynamicResource PinBrush}" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" ToolTip="删除"
                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Item}">
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconClose}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="selectionRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============ 内容行：图片 ============
             MouseEnter/Leave：悬停 0.5s 弹出大图预览（移开即关，见 ImageRow_MouseEnter） -->
        <DataTemplate x:Key="ImageItemTemplate" DataType="{x:Type vm:ClipboardItemRow}">
            <Border x:Name="selectionRing" Margin="6,1" BorderThickness="2" CornerRadius="8"
                    BorderBrush="Transparent" Background="Transparent"
                    PreviewMouseLeftButtonDown="ItemDragStart"
                    PreviewMouseMove="ItemDragMove"
                    MouseLeftButtonUp="Item_Click"
                    MouseEnter="ImageRow_MouseEnter"
                    MouseLeave="ImageRow_MouseLeave"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border.ContextMenu>
                    <ContextMenu Opened="ItemContextMenu_Opened">
                        <MenuItem x:Name="MoveMenu" Header="移动到分组…"
                                  ToolTip="将此项移到其他分组"
                                  Visibility="{Binding PlacementTarget.DataContext.CanManage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Bool2Vis}}" />
                        <Separator />
                        <MenuItem Header="置顶"
                                  Command="{Binding PlacementTarget.Tag.PinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.CanPin, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Bool2Vis}}" />
                        <MenuItem Header="取消置顶"
                                  Command="{Binding PlacementTarget.Tag.UnpinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.CanUnpin, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource Bool2Vis}}" />
                        <MenuItem Header="删除"
                                  Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border x:Name="card" Padding="8,6" CornerRadius="6" Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinnedContext}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PinBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PinBrush}" />
                                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding IsPinnedContext}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding IsPinnedContext}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource PinBackgroundHoverBrush}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Text="{Binding Item.DisplayIndex}" />

                        <Border Grid.Column="1" Width="96" Height="96" Margin="4,0"
                                Background="{DynamicResource ThumbnailBackgroundBrush}"
                                CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Image Source="{Binding Item.Thumbnail}" Stretch="UniformToFill" Width="96" Height="96" />
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0">
                            <TextBlock Text="{Binding Item.Preview}" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding Item.SourceApp}" Margin="0,2,0,0"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Item.RelativeTime}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" ToolTip="置顶"
                                    Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Item}"
                                    Visibility="{Binding CanPin, Converter={StaticResource Bool2Vis}}">
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPin}" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" ToolTip="取消置顶"
                                    Command="{Binding DataContext.UnpinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Item}"
                                    Visibility="{Binding CanUnpin, Converter={StaticResource Bool2Vis}}">
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPin}"
                                      Stroke="{DynamicResource PinBrush}" Fill="{DynamicResource PinBrush}" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" ToolTip="删除"
                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Item}">
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconClose}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="selectionRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============ 区域标题行 ============
             分组已改为顶部标签栏，此模板仅在「全部」标签渲染置顶小节标题 -->
        <DataTemplate x:Key="HeaderTemplate" DataType="{x:Type vm:ClipboardHeaderRow}">
            <StackPanel Orientation="Horizontal" Margin="12,8,0,2">
                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPin}"
                      Width="13" Height="13" Margin="0,0,4,0"
                      Stroke="{DynamicResource PinBrush}" Fill="{DynamicResource PinBrush}" />
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource PinBrush}" />
            </StackPanel>
        </DataTemplate>

        <infra:ClipboardEntryTemplateSelector x:Key="EntrySelector"
            HeaderTemplate="{StaticResource HeaderTemplate}"
            TextTemplate="{StaticResource TextItemTemplate}"
            ImageTemplate="{StaticResource ImageItemTemplate}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <DockPanel Grid.Row="0" Margin="12,8,12,6">
            <!-- 容量指示：达到上限时转为警示色 -->
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeCaption}"
                       Text="{Binding CapacityText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapacityWarning}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PinBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 监控开关（眼睛图标，开=睁眼，关=闭眼） -->
                <ToggleButton Style="{StaticResource GhostToggleButton}" ToolTip="监控剪贴板开关"
                              Margin="0,0,4,0"
                              IsChecked="{Binding IsMonitoring, Mode=TwoWay}">
                    <Grid Width="16" Height="16">
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconEye}"
                              Visibility="{Binding IsMonitoring, Converter={x:Static infra:BoolToVisibilityConverter.Instance}}"/>
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconEyeOff}">
                            <Path.Visibility>
                                <Binding Path="IsMonitoring" Converter="{x:Static infra:InverseBoolToVisibilityConverter.Instance}"/>
                            </Path.Visibility>
                        </Path>
                    </Grid>
                </ToggleButton>
                <Button Style="{StaticResource GhostButton}" ToolTip="设置"
                        Margin="0,0,4,0"
                        Click="Settings_Click">
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconSettings}"/>
                </Button>
                <Button Style="{StaticResource GhostButton}" ToolTip="更多操作"
                        Margin="0,0,4,0"
                        Click="Overflow_Click">
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconMore}"/>
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom"
                                     Style="{StaticResource {x:Type ContextMenu}}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="清空普通队列" Command="{Binding ClearNormalCommand}" />
                            <MenuItem Header="切换为亮色主题" Command="{Binding ToggleThemeCommand}"
                                      Visibility="{Binding IsLightTheme, Converter={x:Static infra:InverseBoolToVisibilityConverter.Instance}}" />
                            <MenuItem Header="切换为暗色主题" Command="{Binding ToggleThemeCommand}"
                                      Visibility="{Binding IsLightTheme, Converter={x:Static infra:BoolToVisibilityConverter.Instance}}" />
                            <MenuItem Header="重置序号" Command="{Binding ResetSequenceCommand}" />
                            <Separator />
                            <MenuItem Header="支持作者" Click="SupportAuthorMenu_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ToggleButton Style="{StaticResource PillButton}"
                              IsChecked="{Binding ModeOn, Mode=TwoWay}"
                              Content="{Binding ModeOn, Converter={x:Static infra:ModeLabelConverter.Instance}, Mode=OneWay}" />
            </StackPanel>
        </DockPanel>

        <Separator Grid.Row="0" VerticalAlignment="Bottom"
                   Background="{DynamicResource BorderBrush}" Margin="0,2" />

        <!-- 搜索框 -->
        <Border Grid.Row="1" Margin="12,2,12,6" Style="{StaticResource SearchBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Style="{StaticResource IconStyle}"
                      Data="{StaticResource IconSearch}" Margin="8,0,6,0"/>
                <TextBox Grid.Column="1" x:Name="SearchBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="搜索复制内容…"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus" />
                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                        Margin="2,0,2,0" Padding="4"
                        ToolTip="清空搜索（Esc）"
                        Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding IsSearching, Converter={x:Static infra:BoolToVisibilityConverter.Instance}}">
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconClose}"/>
                </Button>
            </Grid>
        </Border>

        <!-- 标签栏：全部 / 置顶 / 各分组 / 类型筛选 + 新建分组；
             溢出时横向滚动（滚动条隐藏，滚轮横滚，见 TabScroll_PreviewMouseWheel） -->
        <ScrollViewer Grid.Row="2" x:Name="TabScroll"
                      Margin="12,2,12,4"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="TabScroll_PreviewMouseWheel">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource TabItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Style="{StaticResource GhostButton}" ToolTip="新建分组"
                        VerticalAlignment="Center" Padding="5"
                        Command="{Binding CreateGroupCommand}">
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPlus}"/>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- 列表区 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 首次使用引导：固定在列表上方，不随列表滚动 -->
            <Border Grid.Row="0" Margin="8,6,8,2" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource AccentBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowOnboarding, Converter={StaticResource Bool2Vis}}">
                <StackPanel>
                    <TextBlock Text="欢迎使用 MultiCopy"
                               FontWeight="SemiBold" FontSize="{StaticResource FontSizeTitle}" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource ForegroundBrush}">
                        <Run Text="① 在任意应用 Ctrl+C 复制，内容会自动进入队列" /><LineBreak />
                        <Run Text="② 按 Alt+Z 随时调出本窗口" /><LineBreak />
                        <Run Text="③ 窗口内 ↑↓ 选择，Enter 粘贴" />
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource PinBrush}"
                               Text="注意：Ctrl+Z 与方向键仅在 MultiCopy 窗口内生效；窗口隐藏到托盘时监控暂停。" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Padding="12,4" Content="查看全部快捷键"
                                Click="OpenHelp_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Padding="14,4"
                                Content="知道了，开始使用"
                                Command="{Binding DismissOnboardingCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 单一列表：标题行 + 内容行 -->
            <Grid Grid.Row="1">
                <ListBox x:Name="ResultsList"
                         ItemsSource="{Binding Rows}"
                         ItemTemplateSelector="{StaticResource EntrySelector}"
                         ItemContainerStyle="{StaticResource ClipboardListBoxItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,4"
                         SelectionMode="Single"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" />

                <!-- 空状态覆盖层 -->
                <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource Bool2Vis}}">
                    <!-- 搜索无结果 -->
                    <StackPanel Visibility="{Binding SearchNoResult, Converter={x:Static infra:BoolToVisibilityConverter.Instance}}">
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconSearch}"
                              Width="32" Height="32" HorizontalAlignment="Center"
                              StrokeThickness="1.5" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{DynamicResource ForegroundDimBrush}">
                            <Run Text="未找到匹配「" /><Run Text="{Binding SearchText}" /><Run Text="」的条目" />
                        </TextBlock>
                    </StackPanel>
                    <!-- 队列空（无搜索）：文案随当前标签类型变化 -->
                    <StackPanel Visibility="{Binding IsSearching, Converter={x:Static infra:InverseBoolToVisibilityConverter.Instance}}">
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconInbox}"
                              Width="32" Height="32" HorizontalAlignment="Center"
                              StrokeThickness="1.5" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   Text="{Binding EmptyStateText}" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   Text="{Binding EmptyStateHint}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <!-- 底部操作提示：动态文案 + 可见的撤销按钮；点击空白处打开快捷键说明 -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" Padding="12,6"
                Cursor="Hand" ToolTip="点击查看全部快捷键"
                MouseLeftButtonDown="Help_Click">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="4"
                        Margin="6,0,0,0" VerticalAlignment="Center"
                        ToolTip="撤销上一步（Ctrl+Z）"
                        IsEnabled="{Binding CanUndo}"
                        Command="{Binding UndoLastRemovalCommand}">
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconUndo}"/>
                </Button>
                <TextBlock FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{Binding OperationHint}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>