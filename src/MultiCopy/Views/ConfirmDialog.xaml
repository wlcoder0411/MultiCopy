<Window x:Class="MultiCopy.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="MessageText"
                   FontSize="{StaticResource FontSizeBody}"
                   TextWrapping="Wrap" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}"
                    Content="确定" Margin="0,0,8,0" IsDefault="True" Click="Confirm_Click" />
            <Button Style="{StaticResource SecondaryButton}"
                    Content="取消" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
