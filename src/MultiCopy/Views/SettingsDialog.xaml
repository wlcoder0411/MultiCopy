<Window x:Class="MultiCopy.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="420" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 启用开关 -->
        <CheckBox Grid.Row="0" x:Name="EnableCheckBox"
                  Content="启用全局快捷键（调出主窗口）"
                  FontSize="{StaticResource FontSizeBody}"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Margin="0,0,0,12"
                  Checked="Enable_Changed" Unchecked="Enable_Changed" />

        <!-- 捕获区标签 -->
        <TextBlock Grid.Row="1" Margin="0,0,0,4"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource ForegroundDimBrush}"
                   Text="快捷键组合：" />

        <!-- 捕获 TextBox（按下组合键即记录，事件由 HotkeyCapture 挂接） -->
        <Border Grid.Row="2" Style="{StaticResource SearchBorder}" Margin="0,0,0,4">
            <TextBox x:Name="CaptureBox"
                     Style="{StaticResource SearchTextBoxStyle}"
                     IsReadOnly="True"
                     Focusable="True"
                     Padding="8,6"
                     Tag="点击此处后按下组合键…" />
        </Border>

        <!-- 提示文字 -->
        <TextBlock Grid.Row="3" x:Name="HintBlock"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource ForegroundDimBrush}"
                   Text="需至少一个修饰键（Alt/Ctrl/Shift/Win）+ 一个主键"
                   TextWrapping="Wrap" />

        <!-- 分隔线（主热键 / 片段速取热键） -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource ForegroundDimBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,12" Opacity="0.3" />

        <!-- 片段速取热键 -->
        <CheckBox Grid.Row="5" x:Name="SnippetEnableCheckBox"
                  Content="启用片段速取热键（呼出片段库速取窗，默认 Alt+S）"
                  FontSize="{StaticResource FontSizeBody}"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Margin="0,0,0,8"
                  Checked="Enable_Changed" Unchecked="Enable_Changed" />
        <Border Grid.Row="6" Style="{StaticResource SearchBorder}" Margin="0,0,0,4">
            <TextBox x:Name="SnippetCaptureBox"
                     Style="{StaticResource SearchTextBoxStyle}"
                     IsReadOnly="True"
                     Focusable="True"
                     Padding="8,6"
                     Tag="点击此处后按下组合键…" />
        </Border>
        <TextBlock Grid.Row="7" x:Name="SnippetHintBlock"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource ForegroundDimBrush}"
                   Text="在任意窗口呼出片段速取框，搜索后 Enter 直接粘贴"
                   TextWrapping="Wrap" />

        <!-- 分隔线（快捷键区 / 粘贴区） -->
        <Border Grid.Row="8" BorderBrush="{DynamicResource ForegroundDimBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,12" Opacity="0.3" />

        <!-- 粘贴前后缀标签 -->
        <TextBlock Grid.Row="9" Margin="0,0,0,8"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource ForegroundDimBrush}"
                   Text="粘贴前缀/后缀内容（每次粘贴自动追加，默认无）：" />

        <!-- 前缀启用开关 -->
        <CheckBox Grid.Row="10" x:Name="EnablePrefixCheckBox"
                  Content="启用前缀"
                  FontSize="{StaticResource FontSizeBody}"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Margin="0,0,0,4"
                  Checked="SequenceDependency_Changed" Unchecked="SequenceDependency_Changed" />

        <!-- 前缀内容摘要框（点击弹出多行编辑） -->
        <Border Grid.Row="11" Style="{StaticResource SearchBorder}" Cursor="Hand"
                MouseLeftButtonDown="PrefixSummaryBorder_MouseLeftButtonDown">
            <TextBox x:Name="PrefixSummaryTextBox"
                     Style="{StaticResource SearchTextBoxStyle}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     Focusable="False"
                     Text="点击此处编辑前缀内容…" />
        </Border>

        <!-- 序号自增配置区域（序号仅作用于前缀，需先启用前缀） -->
        <CheckBox Grid.Row="12" x:Name="EnableSequenceCheckBox"
                  Content="启用序号自增（需启用前缀）"
                  FontSize="{StaticResource FontSizeBody}"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Margin="0,8,0,4"
                  Checked="SequenceDependency_Changed" Unchecked="SequenceDependency_Changed" />

        <Grid Grid.Row="13" x:Name="SequenceEditorGrid" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 起始序号 -->
            <TextBlock Grid.Column="0" Text="起始："
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundDimBrush}"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
            <Border Grid.Column="1" Style="{StaticResource SearchBorder}" Width="50" Margin="0,0,12,0">
                    <TextBox x:Name="SequenceStartTextBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Padding="4,2"
                         PreviewTextInput="SequenceStartTextBox_PreviewTextInput"
                         DataObject.Pasting="SequenceStartTextBox_Pasting"
                         TextChanged="PreviewSetting_Changed" />
            </Border>

            <!-- 序号格式 -->
            <TextBlock Grid.Column="2" Text="格式："
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundDimBrush}"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Grid.Column="3" x:Name="SequenceFormatCombo"
                      SelectedIndex="0" Margin="0,0,12,0"
                      FontSize="{StaticResource FontSizeCaption}"
                      SelectionChanged="PreviewSetting_Changed">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="01" />
                <ComboBoxItem Content="(1)" />
                <ComboBoxItem Content="1." />
                <ComboBoxItem Content="1、" />
            </ComboBox>

            <!-- 序号位置 -->
            <TextBlock Grid.Column="4" Text="位置："
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundDimBrush}"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Grid.Column="5" x:Name="SequencePositionCombo"
                      SelectedIndex="0"
                      FontSize="{StaticResource FontSizeCaption}"
                      SelectionChanged="PreviewSetting_Changed">
                <ComboBoxItem Content="前缀后" />
                <ComboBoxItem Content="前缀前" />
            </ComboBox>
        </Grid>

        <!-- 后缀启用开关 -->
        <CheckBox Grid.Row="14" x:Name="EnableSuffixCheckBox"
                  Content="启用后缀"
                  FontSize="{StaticResource FontSizeBody}"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Margin="0,8,0,4"
                  Checked="PreviewSetting_Changed" Unchecked="PreviewSetting_Changed" />

        <!-- 后缀内容摘要框（点击弹出多行编辑） -->
        <Border Grid.Row="15" Style="{StaticResource SearchBorder}" Cursor="Hand"
                MouseLeftButtonDown="SuffixSummaryBorder_MouseLeftButtonDown">
            <TextBox x:Name="SuffixSummaryTextBox"
                     Style="{StaticResource SearchTextBoxStyle}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     Focusable="False"
                     Text="点击此处编辑后缀内容…" />
        </Border>

        <!-- 分隔线（粘贴区 / 队列容量区） -->
        <Border Grid.Row="16" BorderBrush="{DynamicResource ForegroundDimBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,12" Opacity="0.3" />

        <!-- 队列容量上限 -->
        <TextBlock Grid.Row="17" Margin="0,0,0,8"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource ForegroundDimBrush}"
                   Text="队列容量上限（普通队列存满后暂停采集，不清理已有条目）：" />
        <Grid Grid.Row="18" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SearchBorder}" Width="50" Margin="0,0,8,0">
                <TextBox x:Name="QueueCapacityTextBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Padding="4,2"
                         PreviewTextInput="QueueCapacityTextBox_PreviewTextInput"
                         DataObject.Pasting="QueueCapacityTextBox_Pasting" />
            </Border>
            <TextBlock Grid.Column="1" Text="条（5–200）"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundDimBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- 粘贴效果预览 -->
        <StackPanel Grid.Row="19" Margin="0,2,0,0">
            <TextBlock FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundDimBrush}"
                       Text="粘贴效果预览：" />
            <TextBlock x:Name="PreviewTextBlock" Margin="0,3,0,0"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       TextWrapping="Wrap" MaxHeight="52"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </StackPanel>

        <!-- 按钮区 -->
        <StackPanel Grid.Row="21" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}"
                    Content="确定" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Style="{StaticResource SecondaryButton}"
                    Content="取消" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
