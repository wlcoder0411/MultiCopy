<Window x:Class="MultiCopy.Views.SnippetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="片段库"
        Width="480" Height="560"
        MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        ShowActivated="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 搜索 + 新增 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SearchBorder}">
                <TextBox x:Name="SnippetSearchBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="搜索片段（名称或内容）…"
                         TextChanged="SnippetSearchBox_TextChanged"
                         GotFocus="SnippetSearchBox_GotFocus" />
            </Border>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="5"
                    Margin="6,0,0,0" ToolTip="新增片段"
                    Click="AddSnippet_Click">
                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPlus}"/>
            </Button>
        </Grid>

        <!-- 片段列表 -->
        <ListBox Grid.Row="1" x:Name="SnipList"
                 ItemsSource="{Binding Entries}"
                 HorizontalContentAlignment="Stretch"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="False">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- 右键菜单放在 DataTemplate 的 Border 上（Style Setter 里不能挂事件/菜单，
                         会在运行时抛 XamlParseException）；命令经 Tag（窗口自身）绑定 -->
                    <Border Padding="8,5" CornerRadius="6" Cursor="Hand"
                            Background="Transparent"
                            MouseLeftButtonUp="SnippetItem_Click"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑"
                                          Command="{Binding PlacementTarget.Tag.EditSnippetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="删除"
                                          Command="{Binding PlacementTarget.Tag.DeleteSnippetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Subtitle}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="ToolTip" Value="{Binding Model.Content}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSecret}" Value="True">
                            <Setter Property="ToolTip" Value="隐藏内容：粘贴时使用真实内容，右键编辑可查看" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- 空状态 -->
        <TextBlock Grid.Row="1" Text="还没有片段：点 ＋ 新增，或在主列表条目右键「存入片段库」"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource ForegroundDimBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="2" Margin="0,8,0,0"
                   Text="单击粘贴（原样输出，不附加前后缀） · 右键编辑/删除"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource ForegroundDimBrush}" />
    </Grid>
</Window>
