<Window x:Class="MultiCopy.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图像预览"
        Width="360" Height="360"
        MinWidth="280" MinHeight="220"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：可拖动 + 关闭按钮 -->
            <DockPanel Grid.Row="0" Margin="12,8,8,2" Background="Transparent"
                       MouseLeftButtonDown="Caption_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="4"
                        ToolTip="关闭（Esc / 空格）" Click="Close_Click">
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconClose}" Width="14" Height="14" />
                </Button>
                <TextBlock VerticalAlignment="Center" Text="预览（空格 开/关）"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ForegroundDimBrush}" />
            </DockPanel>

            <!-- 原始大图（等比缩放适配窗口，数据为入队时 Freeze 的全尺寸位图） -->
            <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" Margin="12,4" />

            <!-- 元信息：来源 · 复制时间 · 像素尺寸 -->
            <TextBlock x:Name="InfoText" Grid.Row="2" Margin="12,2,12,8"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundDimBrush}" />
        </Grid>
    </Border>
</Window>
