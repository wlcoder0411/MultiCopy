<Window x:Class="MultiCopy.Views.SnippetEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑片段"
        Width="400" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题说明 -->
        <TextBlock x:Name="TitleTextBlock" Grid.Row="0" Margin="0,0,0,10"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource ForegroundDimBrush}" />

        <!-- 备注名 -->
        <Border Grid.Row="1" Style="{StaticResource SearchBorder}" Margin="0,0,0,8">
            <TextBox x:Name="NameBox"
                     Style="{StaticResource SearchTextBoxStyle}"
                     Padding="8,6"
                     Tag="备注名（可选，便于搜索）…" />
        </Border>

        <!-- 内容 -->
        <Border Grid.Row="3" Style="{StaticResource SearchBorder}">
            <TextBox x:Name="ContentTextBox"
                     Style="{StaticResource SearchTextBoxStyle}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="8,6"
                     Tag="片段内容（粘贴时原样输出）…"
                     PreviewKeyDown="ContentTextBox_PreviewKeyDown" />
        </Border>

        <!-- 隐藏内容开关 -->
        <CheckBox Grid.Row="4" x:Name="SecretCheckBox"
                  Content="隐藏内容（列表显示 ●●●●，适合密码等敏感片段）"
                  FontSize="{StaticResource FontSizeCaption}"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Margin="0,10,0,0" />

        <!-- 按钮区 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" IsDefault="True" Click="Ok_Click"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="取消" IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
        </StackPanel>
    </Grid>
</Window>
