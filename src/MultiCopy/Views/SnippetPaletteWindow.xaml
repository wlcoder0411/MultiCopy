<Window x:Class="MultiCopy.Views.SnippetPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="片段速取"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="True" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="8" Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="10"
            Cursor="SizeAll"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel>
            <!-- 拖动区：标题即窗口把手（列表占满时仍可稳定拖动） -->
            <TextBlock Text="片段速取" HorizontalAlignment="Center" Margin="0,0,0,6"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundDimBrush}"
                       ToolTip="按住标题或空白处拖动窗口" />

            <!-- 搜索框 -->
            <Border Style="{StaticResource SearchBorder}" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="搜索片段（Enter 粘贴 · Esc 关闭）…"
                         TextChanged="SearchBox_TextChanged" />
            </Border>

            <!-- 片段列表 -->
            <ListBox x:Name="SnipList"
                     ItemsSource="{Binding Entries}"
                     HorizontalContentAlignment="Stretch"
                     BorderThickness="0" Background="Transparent"
                     MaxHeight="320"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,4" CornerRadius="6" Cursor="Hand"
                                Background="Transparent"
                                MouseLeftButtonUp="SnippetItem_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Subtitle}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态 -->
            <TextBlock x:Name="EmptyHint" Text="无匹配片段"
                       HorizontalAlignment="Center" Margin="0,8"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundDimBrush}"
                       Visibility="Collapsed" />

            <!-- 底部提示 -->
            <TextBlock Margin="0,8,0,0"
                       Text="↑↓ 选择 · Enter 粘贴 · Esc 关闭 · 拖动标题移动"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource ForegroundDimBrush}" />
        </StackPanel>
    </Border>
</Window>
