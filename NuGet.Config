<?xml version="1.0" encoding="utf-8"?>
<!--
  项目级 NuGet 源配置
  用国内镜像（华为云）替代 nuget.org，避免在国内网络环境下访问 nuget.org 超时
  导致 dotnet restore / publish 长时间卡住。
  <clear /> 清除继承的全局源（含 nuget.org），只用华为云镜像（已镜像 nuget.org 全部包）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="huaweicloud" value="https://mirrors.huaweicloud.com/repository/nuget/v3/index.json" />
  </packageSources>
</configuration>
